<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The engine reference carries polyfill packages whose "unsupported TFM" build warnings
         would otherwise surface here; build-time only, the compiled IL is unaffected. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- Microsoft.Data.Sqlite / sqlSugarCore carry SQLitePCLRaw.lib.e_sqlite3, whose
         runtime.json advertises alpine/linux-musl RIDs absent from our RID graph.
         NETSDK1206 is dependency-side noise; no supported asset is dropped. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="sqlSugarCore" Version="5.1.3" />
    <PackageReference Include="FreeSql.Provider.SqlServer" Version="3.5.311" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- F8-03: the provider packages the nine integrations are built against. The async seam
         suite reflects over the adapter assemblies, which means the CLR has to resolve the
         providers' own types (ISelect, ISugarQueryable, IQueryOver, Query, DbContext, ...) while
         walking their signatures, so the providers are a compile-time need here even though no
         connection is ever opened. Versions match the adapter projects exactly. -->
    <PackageReference Include="Chloe" Version="5.56.0" />
    <PackageReference Include="Dos.ORM" Version="8.2.7" />
    <PackageReference Include="EntityFramework" Version="6.5.2" />
    <PackageReference Include="FreeSql.DbContext" Version="3.5.311" />
    <PackageReference Include="NHibernate" Version="5.7.0" />
    <PackageReference Include="SqlKata.Execution" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetCore.Collections\DotNetCore.Collections.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- F8-03: all nine integrations, so the async seam can be pinned for every one of them in a
         single suite. Referencing all of them here (instead of one project per provider) keeps the
         matrix in one file, which is the only way the "who forwards the token" claim can be read
         and asserted side by side. -->
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.Chloe\DotNetCore.Collections.Paginable.Chloe.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.DosOrm\DotNetCore.Collections.Paginable.DosOrm.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.EntityFramework\DotNetCore.Collections.Paginable.EntityFramework.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.EntityFrameworkCore\DotNetCore.Collections.Paginable.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.FreeSql\DotNetCore.Collections.Paginable.FreeSql.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.FreeSql.DbContext\DotNetCore.Collections.Paginable.FreeSql.DbContext.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.NHibernate\DotNetCore.Collections.Paginable.NHibernate.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.SqlKata\DotNetCore.Collections.Paginable.SqlKata.csproj" />
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable.SqlSugar\DotNetCore.Collections.Paginable.SqlSugar.csproj" />
  </ItemGroup>

</Project>
