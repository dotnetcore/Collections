<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Aligned with DotNetCore.Collections.Paginable.Tests. netcoreapp3.1 is out
         of support and no longer ships a runtime, so the suite used to need
         DOTNET_ROLL_FORWARD=LatestMajor to run. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Multi\DotNetCore.Collections.Multi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The property-testing kit is shared source, not a shared package: the same files are
         linked into DotNetCore.Collections.Multi.NetFxTests (net462) so that one suite covers
         both runtime generations without adding a project or a dependency. The sources stay at
         C# 7.3 because the net462 project compiles them at its default language version. -->
    <Compile Include="..\Shared\PropertyTesting\**\*.cs"
             Link="Shared\PropertyTesting\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
