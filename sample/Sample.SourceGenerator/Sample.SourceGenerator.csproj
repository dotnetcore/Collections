<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sample.SourceGenerator</RootNamespace>
    <AssemblyName>Sample.SourceGenerator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 说明型 sample：只引用分页核心包。
         SourceGenerators 包是 Analyzer（OutputItemType=Analyzer），**不随消费者包发布**，
         不能当运行库引用——所以这里也不引用它，仅用字符串讲解生成物形状（见规范 §7）。 -->
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
  </ItemGroup>

</Project>
