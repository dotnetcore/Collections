<Project>

	<Import Project="version.props" />

	<!-- DocumentationFile xmlns: NOT $(OutputPath). This file is imported at the
	     very top of the project, long before the SDK targets have computed
	     $(OutputPath), so $(OutputPath) is still empty here and the value would
	     silently collapse to the bare $(AssemblyName).xml in the project root.
	     (That is exactly the old, broken behaviour.)

	     The XML doc must live under the per-TFM output directory: pointing it at
	     a single project-root file makes every target framework of a
	     multi-targeting build write the *same* file, so parallel inner builds
	     race and fail at random with CS0016 ("file is being used by another
	     process"). $(BaseOutputPath) and $(Configuration) ARE available at import
	     time, and $(TargetFramework) is set by the outer cross-targeting build
	     when it launches each inner build, so the path below is unique per TFM. -->
	<PropertyGroup>
		<DocumentationFile>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
	</PropertyGroup>

	<Import Project="package.props" />

	<Import Project="misc.props" />

	<!-- Deterministic build + SourceLink + symbol packages + locked dependencies.
	     Package versions come from version.props and must NOT be overridden
	     per project: the csproj is evaluated after this import and would win. -->
	<PropertyGroup>
		<Deterministic>true</Deterministic>
		<RepositoryUrl>https://github.com/dotnetcore/Collections.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath=""/>
		<None Include="..\..\msic\images\icon.png" Pack="true" PackagePath=""/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

</Project>
