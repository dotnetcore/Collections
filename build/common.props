<Project>

	<Import Project="version.props" />

	<!-- DocumentationFile xmlns: NOT $(OutputPath). This file is imported at the
	     very top of the project, long before the SDK targets have computed
	     $(OutputPath), so $(OutputPath) is still empty here and the value would
	     silently collapse to the bare $(AssemblyName).xml in the project root.
	     (That is exactly the old, broken behaviour.)

	     The XML doc must live under the per-TFM output directory: pointing it at
	     a single project-root file makes every target framework of a
	     multi-targeting build write the *same* file, so parallel inner builds
	     race and fail at random with CS0016 ("file is being used by another
	     process"). $(BaseOutputPath) and $(Configuration) ARE available at import
	     time, and $(TargetFramework) is set by the outer cross-targeting build
	     when it launches each inner build, so the path below is unique per TFM. -->
	<PropertyGroup>
		<DocumentationFile>$(BaseOutputPath)$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<!-- F6-23: every library in this repository ships with nullable reference annotations
		     enabled, so consumers compiling with nullable context get accurate null-state
		     analysis of the public API. Per-project overrides stay possible (a csproj value
		     wins over this import). -->
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- F6-23: the low-generation targets have no in-box nullable attribute types, so a single
	     shared internal polyfill (build/NullabilityAttributes.cs) is compiled into each
	     assembly for them - same shape Roslyn embeds itself when no definition is reachable.
	     netstandard2.1 and net6.0+ define the types in-box and must NOT take this copy. The
	     condition is evaluated per inner build, where $(TargetFramework) is set by the
	     cross-targeting dispatch (same mechanism as the DocumentationFile path above). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net451' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'net47' or '$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'netstandard2.0'">
		<Compile Include="$(MSBuildThisFileDirectory)NullabilityAttributes.cs" Link="NullabilityAttributes.cs" />
	</ItemGroup>

	<Import Project="package.props" />

	<Import Project="misc.props" />

	<!-- Deterministic build + SourceLink + symbol packages + locked dependencies.
	     Package versions come from version.props and must NOT be overridden
	     per project: the csproj is evaluated after this import and would win. -->
	<PropertyGroup>
		<Deterministic>true</Deterministic>
		<RepositoryUrl>https://github.com/dotnetcore/Collections.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath=""/>
		<None Include="..\..\msic\images\icon.png" Pack="true" PackagePath=""/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
	</ItemGroup>

</Project>
