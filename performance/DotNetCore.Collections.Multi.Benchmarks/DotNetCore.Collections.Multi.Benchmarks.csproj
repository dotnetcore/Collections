<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- F6-34: the second head-to-head axis needs a .NET Framework target because its reference
         implementation ships a net461 asset only. net8.0 stays the default target and is what
         the existing (BCL-referenced) sweeps run on; the arms for this axis are compiled only
         into the Framework target. Both targets build from this one project - no second project. -->
    <TargetFrameworks>net8.0;net461</TargetFrameworks>
    <!-- The existing benchmark files use syntax newer than the net461 default (7.3), so the
         Framework leg has to be lifted. Deliberately scoped to net461: net8.0 keeps the language
         version it already had before this project went multi-target, so the F6-26 sweep's
         compilation is left exactly as it was. -->
    <LangVersion Condition="'$(TargetFramework)' == 'net461'">latest</LangVersion>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- F6-26: the head-to-head sweep needs the reference implementation in the same process as
         the Collections arm, which is the only way both arms see the same runtime, the same JIT
         decisions and the same machine noise. The package carries net35 / net40 / net45 /
         netstandard1.0 assets; this net8.0 harness resolves the netstandard1.0 one. It is a
         benchmark-only dependency - nothing under src/ references it. -->
    <PackageReference Include="Kaos.Collections" Version="4.1.0" />
  </ItemGroup>

  <!-- F6-34: this axis's reference implementation ships a net461 asset only, so it can only be
       referenced from the Framework target. It is a benchmark-only dependency - nothing under
       src/ references it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Dangr.Collections" Version="3.1.0" />
    <!-- SpanBag<T> is compiled into the package only on netstandard2.1 / net6.0+ (it needs an
         in-box Span<T>; see src/DotNetCore.Collections.Multi/SpanBag.cs), so its benchmark cannot
         exist on the Framework target either. -->
    <Compile Remove="SpanBagBenchmarks.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetCore.Collections.Multi\DotNetCore.Collections.Multi.csproj" />
  </ItemGroup>

</Project>
