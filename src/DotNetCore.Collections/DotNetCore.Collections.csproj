<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\common.props"/>

    <PropertyGroup>
        <!-- Aligned with DotNetCore.Collections.Multi / Paginable: the full legacy + modern matrix.
             The source is C# 8 without Index/Range/init-only/records, so every target
             from net451 up to net10.0 compiles from one code path. -->
        <TargetFrameworks>net451;net461;net47;net48;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>8.0</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Microsoft.SourceLink.GitHub (build-time only, PrivateAssets) transitively pulls
             System.IO.Hashing, whose netcoreapp2.0 targets warn when building net6.0.
             Suppressed per upstream guidance; does not affect the produced package. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.Collections</AssemblyName>
        <PackageId>DotNetCore.Collections</PackageId>
        <PackageTags>Collections;Linq;ValueEnumerable;Polyfill;ZeroAllocation</PackageTags>
        <Description>High-performance LINQ engine with value-type enumerators and zero-allocation hot paths for .NET.</Description>
    </PropertyGroup>

    <!-- F7-01 + F7-02: polyfill packages for TFMs lacking in-box Span / ArrayPool / Unsafe.
         netstandard2.1 ships Span / Memory / ArrayPool in-box and net6.0+ ships all of them,
         so those two generations must NOT take the System.Memory / System.Buffers references.

         Unsafe is the one exception: it only reaches the BCL in-box with .NET Core 3.0 / .NET 5+,
         so netstandard2.1 needs the package as well (F7-02 is the first code to call Unsafe.As).

         Version notes:
         - System.Memory 4.6.3 targets net462+ / netstandard2.0+; it has NO net451 build.
           For net451 we pin 4.5.5 (the last version with a .NETFramework4.5 target).
           SourceLink transitively requires System.Memory >= 4.6.3, which is unsatisfiable
           on net451; the resulting NU1605 is suppressed below.
         - System.Runtime.CompilerServices.Unsafe 6.0.0+ dropped net451 support.
           For net451 we pin 5.0.0 (the last version targeting .NETFramework4.5).
         - System.Buffers 4.6.1 also dropped net451 (min is net462); for net451 we pin 4.5.1.
           SourceLink transitively requires >= 4.6.1, also unsatisfiable on net451. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net451'">
        <PackageReference Include="System.Memory" Version="4.5.5" />
        <PackageReference Include="System.Buffers" Version="4.5.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="5.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net461' Or '$(TargetFramework)' == 'net47' Or '$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory" Version="4.6.3" />
        <PackageReference Include="System.Buffers" Version="4.6.1" />
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <!-- netstandard2.1 has Span / Memory / ArrayPool in-box but not Unsafe. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    </ItemGroup>

    <!-- net451: SourceLink's transitive requirements (System.Memory >= 4.6.3, System.Buffers >= 4.6.1)
         cannot be met on net451 (neither version has a net451 build). Suppress NU1605 for this TFM only. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net451'">
        <NoWarn>$(NoWarn);NU1605</NoWarn>
    </PropertyGroup>

    <!-- F7-01: ValueTuple is in-box from net47 upwards; only net451 and net461 need the package. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net451' Or '$(TargetFramework)' == 'net461'">
        <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotNetCore.Collections.Tests" />
        <!-- F7-02: the four .NET Framework generations the package targets cannot be reached by
             the xunit stack (Microsoft.NET.Test.Sdk needs net462 or newer), yet the list arm rests
             on the field layout of List<T> on exactly those generations. The probe is therefore a
             self-checking console app that compares ListLayoutAccessor against reflection, and it
             needs the internal accessor to do so. -->
        <InternalsVisibleTo Include="DotNetCore.Collections.FrameworkProbe" />
        <!-- F7-04: the Go/No-Go baseline suite has to measure the operators, and F7-03 deliberately
             kept them off the public API until F7-07 settles the namespace and the overload
             resolution. This grant is therefore temporary by design: once F7-07 publishes the
             operator surface, the benchmark arms move to the public entry points and this line
             should go with it. -->
        <InternalsVisibleTo Include="DotNetCore.Collections.Benchmarks" />
    </ItemGroup>

</Project>
