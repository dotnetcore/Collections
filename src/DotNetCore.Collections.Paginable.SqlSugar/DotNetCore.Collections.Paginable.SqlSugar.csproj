<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\common.props" />

  <PropertyGroup>
    <TargetFrameworks>net451;net461;net47;net48;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DotNetCore.Collections.Paginable.SqlSugar</AssemblyName>
    <PackageId>DotNetCore.Collections.Paginable.SqlSugar</PackageId>
    <Description>Paginable extension with SqlSugar for collection.</Description>
  </PropertyGroup>

  <!-- .NET Framework 使用 sqlSugar（纯 nfx 程序集）；其余目标使用 sqlSugarCore（netstandard2.1） -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="sqlSugar" Version="5.1.3" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="sqlSugarCore" Version="5.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
  </ItemGroup>

</Project>
