<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\common.props"/>

  <PropertyGroup>
    <!-- Dos.ORM 8.x 仅提供 netstandard2.1 资产，.NET Framework 目标不再受支持 -->
    <TargetFrameworks>netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DotNetCore.Collections.Paginable.DosORM</AssemblyName>
    <PackageId>DotNetCore.Collections.Paginable.DosORM</PackageId>
    <Description>Paginable extension with Dos.ORM for collection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dos.ORM" Version="8.2.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
  </ItemGroup>

</Project>
