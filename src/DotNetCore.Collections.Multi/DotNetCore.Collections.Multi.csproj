<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\common.props"/>

    <PropertyGroup>
        <!-- Aligned with DotNetCore.Collections.Paginable: the full legacy + modern matrix.
             The source is C# 8 without Index/Range/init-only/records, so every target
             from net451 up to net10.0 compiles from one code path. -->
        <TargetFrameworks>net451;net461;net47;net48;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>8.0</LangVersion>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Microsoft.SourceLink.GitHub (build-time only, PrivateAssets) transitively pulls
             System.IO.Hashing, whose netcoreapp2.0 targets warn when building net6.0.
             Suppressed per upstream guidance; does not affect the produced package. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.Collections.Multi</AssemblyName>
        <PackageId>DotNetCore.Collections.Multi</PackageId>
        <!-- The three "multi" types multiply different things and are orthogonal:
             MultiList<T> multiplies elements (1 element -> N copies),
             MultiDictionary<TKey,TValue> multiplies values per key (1 key -> N values) and
             MultiKeyDictionary<TKey,TValue> multiplies key components (N components -> 1 value,
             a trie). TwoKeyDictionary<K1,K2,V> is the strongly typed arity-2 facade over the trie.
             Do not introduce ambiguous names such as "MultiMultiDictionary". -->
        <PackageTags>Collections;MultiSet;MultiDictionary;MultiKeyDictionary;TwoKeyDictionary;Bag;Multimap;CompositeKey</PackageTags>
        <Description>Multiset (bag), multimap and composite-key dictionary collections for .NET.</Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net451'">
        <!-- Named tuples (MultiList.EntrySet) are compiler-mapped to System.ValueTuple,
             which only ships in-box from .NET Framework 4.7 upwards. -->
        <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)'=='net461'">
        <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- The test suite asserts the red-black invariants of OrderedMultiList and the
             height bound that stands in for its O(log n) guarantee (F6-01: invariants, not
             timings). Both live on internal members, so the test assembly has to see them.
             This widens nothing for consumers: the members stay internal. -->
        <InternalsVisibleTo Include="DotNetCore.Collections.Multi.Tests" />
    </ItemGroup>

</Project>
