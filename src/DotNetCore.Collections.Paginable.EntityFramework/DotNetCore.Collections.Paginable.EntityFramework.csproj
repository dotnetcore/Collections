<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\common.props"/>

    <PropertyGroup>
        <!-- EF6 6.5.x ships net4.0+ / netstandard2.1 assets (the latter serves .NET 5+ consumers). -->
        <TargetFrameworks>net451;net461;net47;net48;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.Collections.Paginable.EntityFramework</AssemblyName>
        <PackageId>DotNetCore.Collections.Paginable.EntityFramework</PackageId>
        <Description>Paginable extension with Microsoft EntityFramework for collection.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="EntityFramework" Version="6.5.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
    </ItemGroup>

</Project>
