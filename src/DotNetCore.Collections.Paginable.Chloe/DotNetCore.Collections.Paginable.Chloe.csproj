<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\common.props" />

    <PropertyGroup>
        <!-- Chloe 5.x ships net4.6+ / netstandard2.0 / net6.0+ assets (net451 is no longer supported). -->
        <TargetFrameworks>net461;net47;net48;netstandard2.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.Collections.Paginable.Chloe</AssemblyName>
        <PackageId>DotNetCore.Collections.Paginable.Chloe</PackageId>
        <Description>Paginable extension with Chloe for collection.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Chloe" Version="5.56.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotNetCore.Collections.Paginable\DotNetCore.Collections.Paginable.csproj" />
    </ItemGroup>

</Project>
