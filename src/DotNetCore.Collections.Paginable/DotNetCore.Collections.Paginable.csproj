<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\common.props"/>

    <PropertyGroup>
        <TargetFrameworks>net451;net461;net47;net48;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyName>DotNetCore.Collections.Paginable</AssemblyName>
        <PackageId>DotNetCore.Collections.Paginable</PackageId>
        <Description>Paginable extension for collection.</Description>
        <!-- Since 7.3.0 the engine reference below makes its polyfill packages transitive
             (System.Buffers / System.Memory / System.Numerics.Vectors / Unsafe on net461,
             System.IO.Hashing on net6.0 and net7.0), and each of them carries an
             "unsupported TFM" build warning. The engine and Multi suppress the same set the
             same way; SuppressTfmSupportBuildWarnings does not flow across a ProjectReference,
             so every consuming project has to declare it. Build-time only: the produced
             package and the compiled IL are unaffected. -->
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net461' Or '$(TargetFramework)' == 'net47' Or '$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'netstandard2.0'">
        <!-- F8-01 / F8-02: the streaming face (ToPagesAsync) is typed on IAsyncEnumerable<T>.
             That type is in-box from netstandard2.1 and from .NET 6 upwards, so the four lower
             targets take the polyfill - the same TFM set the engine uses for System.Memory /
             System.Buffers / Unsafe.

             Version note: 1.1.1 is a net461-capable release, not the newest one. Measured from
             the package cache (F8-03 review): a net461 asset exists in 1.0.0, 1.1.0, 1.1.1, 5.0.0
             and 6.0.0, and is gone from 7.0.0 upwards (net462 / netstandard2.0 / netstandard2.1
             only). 6.0.0 is therefore the last net461-capable release, while 1.1.1 is the one
             chosen here: it carries the complete shape this face needs (IAsyncEnumerable<T>,
             IAsyncEnumerator<T>, EnumeratorCancellationAttribute,
             ConfiguredCancelableAsyncEnumerable<T> - all four verified in its net461 asset) with
             the lowest dependency floor, and both 1.1.1 and 6.0.0 depend only on
             System.Threading.Tasks.Extensions 4.5.4. Raising the pin is a deliberate decision,
             not a correction: anything from 7.0.0 up drops net461 from the streaming face while
             net47 keeps it.
             Measured 2026-10-23 (F8-02 probe): on net461 / net47 / net48 / netstandard2.0 the
             package restores, binds and runs an async iterator, await foreach, cancellation and
             release-on-break; on net451 restore fails with NU1202 (no compatible asset), which
             is why the whole streaming face is compiled out there (#if !NET451). -->
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="1.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- 规则 C（对内对外双轨）: the paging internals are required to run on this engine
             rather than fall back to the BCL, so the reference is a hard one. The engine
             targets the same eleven TFMs, so no target loses coverage; the dependency it
             adds to this package is deliberate and shows up as a NuGet dependency of every
             provider integration that builds on top of it. -->
        <ProjectReference Include="..\DotNetCore.Collections\DotNetCore.Collections.csproj" />
    </ItemGroup>

</Project>
